# Copy to .env and fill in. Read by `pnpm dev` and `pnpm seed:exercises` (not `pnpm dev:local`)

# MongoDB Atlas → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fit-coach

# Clerk dashboard → API keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Comma-separated origins allowed to call the API; defaults to the Expo web dev server
CORS_ORIGINS=http://localhost:8081

# Defaults to 3000
# PORT=3000

# Sentry → Project settings → Client Keys (DSN). Leave unset locally: nothing is reported without it
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# production or staging; events say "development" if it's unset
# SENTRY_ENVIRONMENT=production
