# Copy to .env and fill in

# The API to talk to: a local `pnpm dev` / `pnpm dev:local`, or the deployed one
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clerk dashboard → API keys (the same publishable key as the API's)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Sentry, web build only. Read at build time. Leave unset locally: nothing is reported without it
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# production or staging; events say "development" if it's unset
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
